@using MYMVCAPP.Models.ViewModels
@model CartItemViewModel

<section id="cart_items" class="mt-5">
    <div class="container">
        <div class="breadcrumbs mb-3">
            <ol class="breadcrumb bg-light p-2 rounded">
                <li class="breadcrumb-item">
                    <a asp-controller="Home" asp-action="Index">Trang chủ</a>
                </li>
                <li class="breadcrumb-item active">Giỏ hàng</li>
            </ol>
        </div>

        <div class="table-responsive cart_info shadow-sm rounded">
            <form asp-controller="Cart" asp-action="ProcessSelected" method="post">
                <table class="table table-bordered align-middle text-center">
                    <thead class="table-danger">
                        <tr>
                            <th>
                                <input type="checkbox" id="selectAll" class="form-check-input" />
                            </th>
                            <th>Ảnh</th>
                            <th>Sản phẩm</th>
                            <th>Giá</th>
                            <th>Số lượng</th>
                            <th>Tổng</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.CartItems != null && Model.CartItems.Any())
                        {
                            @foreach (var item in Model.CartItems)
                            {
                                <tr>
                                    <td>
                                        <input type="checkbox" name="selectedIds"
                                               value="@(item.VariantId != 0 ? item.VariantId : item.ProductId)"
                                               class="form-check-input item-checkbox" />
                                    </td>

                                    <td style="width: 120px;">
                                        <img src="~/images/products/@item.Img" alt="@item.ProductName"
                                             style="width: 80px; height: 80px; object-fit: cover; border-radius: 8px;" />
                                    </td>

                                    <td class="text-start">
                                        <strong>@item.ProductName</strong>
                                        @if (!string.IsNullOrEmpty(item.Option))
                                        {
                                            <div class="small text-muted">(@item.Option)</div>
                                        }
                                    </td>

                                    <td>@item.Price.ToString("N0") VNĐ</td>

                                    <td>
                                        <div class="d-flex justify-content-center align-items-center gap-2">
                                            <a class="btn btn-outline-secondary btn-sm"
                                               asp-controller="Cart"
                                               asp-action="Decrease"
                                               asp-route-productId="@item.ProductId"
                                               asp-route-variantId="@item.VariantId">−</a>

                                            <span>@item.Quantity</span>

                                            <a class="btn btn-outline-primary btn-sm"
                                               asp-controller="Cart"
                                               asp-action="Increase"
                                               asp-route-productId="@item.ProductId"
                                               asp-route-variantId="@item.VariantId">+</a>
                                        </div>
                                    </td>

                                    <td>
                                        <strong>@((item.Quantity * item.Price).ToString("N0")) VNĐ</strong>
                                    </td>

                                    <td>
                                        <a class="btn btn-danger btn-sm"
                                           asp-controller="Cart"
                                           asp-action="Remove"
                                           asp-route-productId="@item.ProductId"
                                           asp-route-variantId="@item.VariantId">
                                            <i class="fa fa-trash"></i> Xóa
                                        </a>
                                    </td>
                                </tr>
                            }

                            <tr class="table-light">
                                <td colspan="5" class="text-end fw-bold">Tổng cộng:</td>
                                <td colspan="2" class="fw-bold text-danger">
                                    @Model.GrandTotal.ToString("N0") VNĐ
                                </td>
                            </tr>
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4">
                                    <h5>🛒 Giỏ hàng của bạn đang trống</h5>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (Model.CartItems != null && Model.CartItems.Any())
                {
                    <div class="d-flex justify-content-between mt-3">
                        <button type="submit" name="actionType" value="buy" class="btn btn-success">
                            <i class="fa fa-credit-card"></i> Mua mục đã chọn
                        </button>

                        <button type="submit" name="actionType" value="delete" class="btn btn-danger">
                            <i class="fa fa-trash"></i> Xóa mục đã chọn
                        </button>
                    </div>
                }
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        // ✅ Chọn / bỏ chọn tất cả
        document.getElementById("selectAll")?.addEventListener("change", function () {
            const checked = this.checked;
            document.querySelectorAll(".item-checkbox").forEach(cb => cb.checked = checked);
        });
    </script>
}
