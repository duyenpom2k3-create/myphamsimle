@model MYMVCAPP.Models.Order 

@{
    ViewData["Title"] = "Đặt hàng thành công";
}

<div class="container mt-5 mb-5 text-center">
    <div class="alert alert-success p-5 shadow-sm rounded">
        <h2 class="mb-3 text-success">
            <i class="fa fa-check-circle"></i> Đặt hàng thành công!
        </h2>
        <p class="lead">
            @* <-- ĐÃ SỬA: Sử dụng Model.FullName thay vì ViewBag.FullName *@
            Cảm ơn <strong>@Model.FullName</strong> đã mua sắm cùng chúng tôi.
        </p>
        @* <-- ĐÃ SỬA: Sử dụng Model.Id thay vì ViewBag.OrderId *@
        <p>Mã đơn hàng của bạn: <strong>#@Model.Id</strong></p> 
        @* <-- ĐÃ SỬA: Sử dụng Model.PaymentMethod thay vì ViewBag.Payment *@
        <p>Phương thức thanh toán: <strong>@Model.PaymentMethod</strong></p> 
        <hr />
        <a asp-controller="Home" asp-action="Index" class="btn btn-danger mt-3">
            <i class="fa fa-home"></i> Về trang chủ
        </a>
    </div>
</div>