@model IEnumerable<MYMVCAPP.Models.ProductModel>
@await Component.InvokeAsync("Banners")
 <!-- Sản phẩm gợi ý -->
        <h2 class="title text-center">THƯƠNG HIỆU</h2>
        <div id="recommended-item-carousel" class="carousel slide" data-ride="carousel">
@await Component.InvokeAsync("Brands")

     <link rel="stylesheet" href="~/css/home.css" />
 <!-- Sản phẩm gợi ý -->
        <h2 class="title text-center">SẢN PHẨM NỔI BẬT</h2>
        <div id="recommended-item-carousel" class="carousel slide" data-ride="carousel">


<div class="row g-4">
    @foreach (var item in Model)
    {
        <div class="col-md-4">
            <div class="card product-card h-100 text-center">
                
                @if (!string.IsNullOrEmpty(item.Img))
                {
                    <img src="@Url.Content("~/images/products/" + item.Img)" class="card-img-top" alt="@item.Name" />
                }
                else
                {
                    <div class="product-no-image">
                        <span class="text-muted">Chưa có ảnh</span>
                    </div>
                }

                <div class="card-body">
                    <div>
                        <h5 class="card-title" style="font-weight:bold;">@item.Name</h5>
                        <p class="card-text text-danger" style="font-size: 1.25em;">@item.Price.ToString("N0") VND</p>
                        <p class="mb-1" style="font-size: small;">Danh mục: @item.Category?.Name</p>
                        <p style="font-size: small;">Thương hiệu: @item.Brand?.Name</p>
                    </div>

                    <div class="product-buttons mt-2">
                        <a asp-controller="Product" asp-action="Details" asp-route-id="@item.Id" class="btn btn-detail">
                            <i class="fas fa-eye"></i> Chi Tiết
                        </a>
                        <form asp-controller="Wishlist" asp-action="AddToWishlist" method="post" class="m-0">
                            <input type="hidden" name="productId" value="@item.Id" />
                            <button type="submit" class="btn btn-wishlist">
                                <i class="fas fa-heart"></i> Yêu thích
                            </button>
                        </form>
                    </div>
                </div>

                <div class="card-footer">
                    <a class="btn add-to-cart-btn w-100" 
                       asp-action="Add" 
                       asp-controller="Cart" 
                       asp-route-Id="@item.Id">
                        <i class="fas fa-shopping-cart"></i> Thêm vào giỏ hàng
                    </a>
                </div>
            </div>
        </div>
        }
</div>

<script>
    // Script để click vào thẻ sản phẩm chuyển đến chi tiết sản phẩm
    document.querySelectorAll('.product-card').forEach(function(card){
        card.addEventListener('click', function(e){
            // Ngăn chặn hành vi click nếu đang click vào nút/form
            if (e.target.closest('.product-buttons') || e.target.closest('.card-footer a')) {
                return;
            }
            // Tìm link Chi Tiết (btn-detail) và chuyển hướng
            var link = this.querySelector('a.btn-detail');
            if(link) {
                window.location.href = link.href;
            }
        });
    });
</script>