@using MYMVCAPP.Models
@model IEnumerable<Order>

@{
    ViewData["Title"] = "Đơn hàng của tôi";
}

<div class="container py-5">
    <div class="row">
        <!-- Sidebar -->
        <div class="col-md-3">
            @await Component.InvokeAsync("MenuUserSidebar")

        </div>

        <div class="col-md-9">
            <h3 class="mb-4">Đơn hàng của tôi</h3>

            @if (!Model.Any())
            {
                <div class="alert alert-info">Bạn chưa có đơn hàng nào.</div>
            }
            else
            {
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Mã đơn</th>
                            <th>Ngày đặt</th>
                            <th>Trạng thái</th>
                            <th>Tổng tiền</th>
                            <th>Chi tiết</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td>@order.Id</td>
                                <td>@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@order.Status</td>
                                <td>@order.TotalAmount.ToString("N0") đ</td>
                                <td>
                                    <a asp-controller="User" asp-action="OrderDetails" asp-route-id="@order.Id" class="btn btn-sm btn-primary">
                                        Xem chi tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>
