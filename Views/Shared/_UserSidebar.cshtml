        <li class="nav-item @(currentController == "Wishlist" && currentAction == "Wishlist" ? "active" : "")">
            <a href="/Wishlist/Wishlist" class="nav-link">Danh sách yêu thích</a>
        </li>
    </ul> *@
</div>

