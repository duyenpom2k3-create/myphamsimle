@{
    ViewData["Title"] = "Trang chủ Admin";
}

<h2>@ViewData["Title"]</h2>

<div class="row">
    <div class="col-md-4">
        <div class="card bg-info text-white p-3 mb-3">
            <h4>Tổng sản phẩm: @ViewBag.TotalProducts</h4>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-success text-white p-3 mb-3">
            <h4>Tổng danh mục: @ViewBag.TotalCategories</h4>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-warning text-white p-3 mb-3">
            <h4>Tổng thương hiệu: @ViewBag.TotalBrands</h4>
        </div>
    </div>
</div>


