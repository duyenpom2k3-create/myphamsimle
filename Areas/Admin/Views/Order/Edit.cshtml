@model MYMVCAPP.Models.Order

@{
    ViewData["Title"] = $"Sửa đơn hàng #{Model.Id}";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";

    // Danh sách trạng thái
    var statusList = new List<string> { "Đang xử lý", "Đã hoàn tất", "Đã hủy" };
}

<h2 class="text-center mb-4 text-primary">@ViewData["Title"]</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="FullName" class="form-label">Khách hàng</label>
        <input asp-for="FullName" class="form-control" readonly />
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label">Email</label>
        <input asp-for="Email" class="form-control" readonly />
    </div>

    <div class="mb-3">
        <label asp-for="Phone" class="form-label">Điện thoại</label>
        <input asp-for="Phone" class="form-control" readonly />
    </div>

    <div class="mb-3">
        <label asp-for="Address" class="form-label">Địa chỉ</label>
        <textarea asp-for="Address" class="form-control" readonly></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="PaymentMethod" class="form-label">Phương thức thanh toán</label>
        <input asp-for="PaymentMethod" class="form-control" readonly />
    </div>

    <div class="mb-3">
        <label asp-for="Status" class="form-label">Trạng thái</label>
        <select asp-for="Status" class="form-select" asp-items="@(new SelectList(statusList, Model.Status))">
            <option value="">Chưa cập nhật</option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Cập nhật</button>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
