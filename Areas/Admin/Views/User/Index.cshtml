@model IEnumerable<MYMVCAPP.Models.UserModel>

@{
    ViewData["Title"] = "Quản lý Người dùng";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<h2 class="text-center mb-4 text-primary">@ViewData["Title"]</h2>

@if (TempData["success"] != null)
{
    <div class="alert alert-success">@TempData["success"]</div>
}
@if (TempData["error"] != null)
{
    <div class="alert alert-danger">@TempData["error"]</div>
}

<div class="mb-3 text-end">
    <a asp-action="Create" class="btn btn-success"><i class="fa fa-plus-circle"></i> Thêm người dùng</a>
</div>

<table class="table table-bordered table-hover align-middle">
    <thead class="table-light">
        <tr class="text-center">
            <th>#</th>
            <th>Avatar</th>
            <th>Tài khoản</th>
            <th>Email</th>
            <th>Role</th>
            <th>Hành động</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Any())
        {
            int index = 1;
            foreach (var user in Model)
            {
                <tr class="text-center">
                    <td>@index</td>
                    <td>
                        <img src="@(!string.IsNullOrEmpty(user.Avatar) ? "/images/avatars/" + user.Avatar : "/images/avatars/avatar_3.jpg")"
                             alt="Avatar" class="rounded-circle" style="width:40px; height:40px; object-fit:cover;" />
                    </td>
                    <td>@user.Username</td>
                    <td>@user.Email</td>
                    <td>@(user.Role == 1 ? "Admin" : "User")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-primary">Sửa</a>
                        <a asp-action="Delete" asp-route-id="@user.Id" class="btn btn-sm btn-danger"
                           onclick="return confirm('Bạn chắc chắn muốn xóa?')">Xóa</a>
                    </td>
                </tr>
                index++;
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center text-muted">Chưa có người dùng nào.</td>
            </tr>
        }
    </tbody>
</table>
