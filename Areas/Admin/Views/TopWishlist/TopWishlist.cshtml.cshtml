@model IEnumerable<MYMVCAPP.Models.ViewModels.TopWishlistViewModel>
@{
    ViewData["Title"] = "Top sản phẩm yêu thích";
}

<h2>@ViewData["Title"]</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">Chưa có sản phẩm nào được yêu thích!</div>
}
else
{
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>#</th>
                <th>Sản phẩm</th>
                <th>Giá</th>
                <th>Lượt yêu thích</th>
            </tr>
        </thead>
        <tbody>
            @for(int i=0; i < Model.Count(); i++)
            {
                var item = Model.ElementAt(i);
                <tr>
                    <td>@(i+1)</td>
                    <td>@item.Product.Name</td>
                    <td>@item.Product.Price.ToString("C")</td>
                    <td>@item.Count</td>
                </tr>
            }
        </tbody>
    </table>
}
