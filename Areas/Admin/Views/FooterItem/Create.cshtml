@model MYMVCAPP.Models.FooterItem
@{
    ViewData["Title"] = "Thêm Footer Item";
}
<h2>Thêm Footer Item</h2>
<form asp-action="Create" method="post">
    <div class="form-group mb-2">
        <label>Loại mục (ItemType)</label>
        <input asp-for="ItemType" class="form-control" />
    </div>
    <div class="form-group mb-2">
        <label>Tiêu đề</label>
        <input asp-for="ItemTitle" class="form-control" />
    </div>
    <div class="form-group mb-2">
        <label>Thứ tự hiển thị</label>
        <input asp-for="DisplayOrder" class="form-control" type="number" />
    </div>
    <div class="form-group mb-2">
        <label>Nội dung</label>
        <textarea asp-for="Content" class="form-control"></textarea>
    </div>
    <button type="submit" class="btn btn-success">Lưu</button>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</form>
