@{
    var success = TempData["SuccessMessage"] as string;
    var info = TempData["InfoMessage"] as string;
    var error = TempData["ErrorMessage"] as string;
}

@if (!string.IsNullOrEmpty(success))
{
    <div class="alert alert-success alert-dismissible fade show mt-3 text-center shadow-sm" role="alert">
        <i class="fa fa-check-circle"></i> @success
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
    </div>
}

@if (!string.IsNullOrEmpty(info))
{
    <div class="alert alert-info alert-dismissible fade show mt-3 text-center shadow-sm" role="alert">
        <i class="fa fa-info-circle"></i> @info
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
    </div>
}

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger alert-dismissible fade show mt-3 text-center shadow-sm" role="alert">
        <i class="fa fa-exclamation-triangle"></i> @error
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
    </div>
}
